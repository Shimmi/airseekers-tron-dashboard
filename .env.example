# Mapbox access token (public, "pk." prefix). The map widget needs this.
# Copy this file per environment — the real files are gitignored:
#
#   Local dev   →  .env.development.local   (loaded ONLY by `npm run dev`)
#                  Use an UNRESTRICTED public token for convenience.
#
#   Deploy      →  .env.production.local    (loaded ONLY by `npm run build`/`npm run deploy`)
#                  Use a token whose URL restriction is scoped to the deploy
#                  domain (https://tron-dashboard.surge.sh) so it can't be
#                  reused elsewhere if scraped from the bundle.
#
# Why the split (not .env.local + .env.production): each mode loads only its own
# *.local file, so a missing deploy token yields a blank map — an obvious failure —
# instead of silently falling back to the unrestricted dev token in a public build.
#
# Get a token / manage URL restrictions: https://account.mapbox.com/access-tokens/

VITE_MAPBOX_TOKEN=

# PostHog analytics (public project token and ingest host — safe to commit).
# Get your token at https://eu.posthog.com/project/232645/settings/project-details
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
